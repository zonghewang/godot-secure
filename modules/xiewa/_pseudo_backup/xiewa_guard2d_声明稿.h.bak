// =============================================================================
//  xiewa_guard2d.h  —— C++ 命名空间 xiewa_guard2d 的**实现级**还原（非 ClassDB 类）
//  ★ 本版已从"声明级推定"升级为"实现级实测"：虚表、结构体偏移、函数地址、算法均已落地
//
//  来源 : E:\gamezip\XiewaPai\XiewaPai.exe（SHA256 9AF23B57…B6081）
//  目标 : 0x3E09xxx–0x3E1495A 一整块 PE 自校验模块（约 40KB 代码）
//  方式 : .pdata 函数边界（83,660 个函数）+ rip 相对引用归簇 + IAT 名解析 + capstone
//  标注 : [确认] 反汇编直接可见   [推定] 由调用形态推断   [未知] 未闭环
// =============================================================================

#pragma once

#include <stdint.h>
#include <stddef.h>

namespace xiewa_guard2d {

// -----------------------------------------------------------------------------
// 一、方案标识与元数据（RVA 直读）
// -----------------------------------------------------------------------------
// [确认] 0x52A1EDD（30 字符，正是元数据里被逐字节比对的 tag）
static const char kSchemeTag[]     = "pe-text-subtract-relocation-v1";
// [确认] 0x52A22C0（写进 PE 自定义元数据的标记，23 字符）
static const char kMetadataTag[]   = "XIEWA-D4-PE-METADATA-v1";
// [确认] 0x52A1EFC
static const char kHexDigits[]     = "0123456789abcdef";
// [确认] 0x52A2489 起，3072 位 RSA 公钥（PEM，分 6 段存储）
static const char kPublicKeyPem[]  = "-----BEGIN PUBLIC KEY-----";

// =============================================================================
// 二、CurrentProcessReader —— 16 字节对象 + 虚表 0x52A1F20
// -----------------------------------------------------------------------------
//  实测布局：  +0x00 vtable*  → 0x52A1F20
//              +0x08 HMODULE  ← GetModuleHandleW(nullptr)（0x3E0C940）
//  构造点：    0x3E0C910（alloc 16B → 写 vtable → 写 module → 替换 holder → 尾部 jmp 0x3E0C980）
//
//  虚表 0x52A1F20（RVA → 实际函数，均已反汇编确认）：
//      [0] 0x3E0ED60   占位（单条 ret）
//      [1] 0x3E0EEF0   析构（jmp 0x39D0 = operator delete/free）
//      [2] 0x3E0EF00   read(offset, size, out)   ← 0x10 槽
//      [3] 0x3E0F050   image_base()             ← 0x18 槽
//      尾部 0x52A1F58 指向 type_info 名 "N11xiewa_guard2d412_GLOBAL__N_120CurrentProcessReaderE"
// =============================================================================
class CurrentProcessReader {
public:
    void *  vtable;      // +0x00  → 0x52A1F20
    void *  module;      // +0x08  ← GetModuleHandleW(nullptr)
                         //         注意：对象只有 16 字节，无其它成员

    // [确认] 0x3E0EF00（330 字节）
    //   1) 边界检查：offset < 0x20000001 且 size <= 0x20000000-offset 且 base+offset+size 不回绕
    //   2) 区域遍历：从 module+offset 起逐段 VirtualQuery（IAT 0x5327E88），
    //      要求 AllocationBase == module、State == MEM_COMMIT(0x1000)、
    //      Type == MEM_IMAGE(0x1000000)、Protect 不含 PAGE_NOACCESS|PAGE_GUARD(0x101)
    //      以 RegionSize 推进，直到覆盖 [addr, addr+size)
    //   3) 读取：GetCurrentProcess()（IAT 0x5327958）+ ReadProcessMemory（IAT 0x5327CB0）
    //      成功条件 = 返回非 0 且 实际读取字节数 == size
    bool read(uint32_t offset, size_t size, void *out);

    // [确认] 0x3E0F050（≤0x80 字节）
    //   返回 +0x08 的 HMODULE（模块基址），供 ASLR 基址比对使用
    uint64_t image_base();
};

// =============================================================================
// 三、ImageReader —— 校验器（不是类实例化的普通对象，而是"状态 + 一组静态过程"）
// -----------------------------------------------------------------------------
//  状态结构（下文 ImageState），调用链：
//      0x3E0C910  取得/新建 reader → 0x3E0C980 verify
//        0x3E0C980  verify(holder, reader, metadata*, String* err)
//          0x3E0D3C0   read_headers(reader, ImageInfo*, String* err)
//          0x3E0D900   read_relocations(reader, ImageInfo*, String* err)
//          0x3E0E340   read_embedded_stream(vector<uint8>*)
//          0x3E0E4C0   process_chunk(state, chunk_offset)     ← 算法核心
//          0x3E0E340 / 0x3E0ED70(to_hex) / 0x3E0E2E0 / 0x3E0D310(set_error)
// =============================================================================

// ---- 3.1 被校验的"可信元数据"结构（verify 的 r8 参数）------------------------
//  [确认] 偏移取自 0x3E0C980 的读取/比较指令
struct Meta {
    uint32_t version;         // +0x00  必须 == 1
    // ---- String（Godot String 布局：+8 标志位、+0x10 长度、+0x18 数据指针）----
    uint8_t  tag_flags;       // +0x08
    uint64_t tag_len;         // +0x10  必须 == 0x1E（30）
    const char *tag_ptr;      // +0x18  必须等于 kSchemeTag（两段 16B 异或比对）
    uint16_t machine;         // +0x20  必须 0x8664(x64) 或 0x14C(x86)
    uint32_t timestamp;       // +0x24
    uint32_t size_of_image;   // +0x28  取值域 [1, 0x1FFFFFFF]
    uint32_t text_rva;        // +0x2C  必须 <= size_of_image
    uint32_t text_size;       // +0x30  取值域 [1, 0x0FFFFFFF]，且 size_of_image - text_rva >= text_size
    uint64_t image_base;      // +0x38  期望（首选）基址
    uint8_t  digest_text[32]; // +0x40  .text 归一化摘要
    uint8_t  digest_alt[32];  // +0x60  第二摘要；全 0 表示"未提供"（ptest 判定）
};

// ---- 3.2 PE 头解析结果（read_headers 的 out 结构）---------------------------
//  [确认] 0x3E0D3C0 的写入点
struct ImageInfo {
    uint16_t machine;         // +0x00
    uint16_t characteristics; // +0x02
    uint32_t timestamp;       // +0x04
    uint32_t size_of_image;   // +0x08
    uint32_t size_of_headers; // +0x0C
    uint32_t text_raw_ptr;    // +0x10
    uint32_t text_size;       // +0x14  max(VirtualSize, SizeOfRawData)
    uint32_t reloc_rva;       // +0x18  （数据目录 #5）
    uint32_t reloc_size;      // +0x1C
    uint64_t opt_image_base;  // +0x20  可选头 ImageBase
    void *   sections_begin;  // +0x28  std::vector<Section> 起
    void *   sections_end;    // +0x30  std::vector<Section> 止
};

// 节表元素 0x1C 字节（[确认] 步进 0x1C；名称与 ".text" 比较用 0x747865742E）
struct Section {
    char     name[8];         // +0x00
    uint32_t virtual_address; // +0x08
    uint32_t virtual_size;    // +0x0C
    uint32_t raw_size;        // +0x10
    uint32_t raw_ptr;         // +0x14
    uint32_t characteristics; // +0x18  .text 要求 MEM_EXECUTE|CNT_CODE（0x20000020）
};

// ---- 3.3 校验状态（0x3E0C980 里 r14 指向的对象）-----------------------------
//  只列出被实际读写的偏移
struct ImageState {
    void *   reader;          // +0x08  CurrentProcessReader*
    void *   owner;           // +0x10
    ImageInfo info;           // +0x18  read_headers/read_relocations 的输出落点
    uint64_t preferred_base;  // +0x38  来自 Meta::image_base，用于算 delta
    // +0x40..+0x88  节表 / 内部缓冲
    void *   relocs_begin;    // +0x58  std::vector<Reloc> 起
    void *   relocs_end;      // +0x60  止
    // +0x90..+0x110  上一份成功基线的完整缓存（用于"元数据没变就复用"）
    uint8_t  inited;          // +0x110 已有基线
    uint8_t  verified;        // +0x111 已通过校验
    uint8_t  err_flags[0x20]; // +0x112
    uint32_t status;          // +0x154 状态码
    uint32_t chunk_offset;    // +0x158 分块进度（字节）
    uint32_t reloc_index;     // +0x160 重定位进度（索引）
    uint32_t result_code;     // +0x168 结果码：0=通过 4=未初始化
    // +0x170..+0x1D0  String 错误消息（0x1E0 内），+0x188/+0x1A8 两段 32B 摘要
};

// 重定位项 8 字节（[确认]：`mov r9d,[rcx+rax*8]` + `movzx r10d,byte[rcx+rax*8+4]`）
struct Reloc {
    uint32_t target;          // +0x00  目标 RVA
    uint8_t  width;           // +0x04  参与减法的字节宽度
    uint8_t  pad[3];
};

// ---- 3.4 过程原型（全部为本模块内的自由函数，非成员）-----------------------
namespace impl {

// [确认] 0x3E0C910
bool obtain_and_verify(ImageState **holder, ImageReaderArg *, Meta *meta, StringLike *err);

// [确认] 0x3E0C980（2435 B）—— 总校验
bool verify(ImageState **holder, CurrentProcessReader *reader, Meta *meta, StringLike *err);

// [确认] 0x3E0D3C0（1341 B）—— 读 PE 头 + 节表，错误经 String* err 直传
bool read_headers(CurrentProcessReader *reader, ImageInfo *out, StringLike *err);

// [确认] 0x3E0D900（2516 B）—— 读重定位表
bool read_relocations(CurrentProcessReader *reader, ImageInfo *info, StringLike *err);

// [确认] 0x3E0E4C0（2199 B）—— 核心：分块读 .text 并按重定位减去 delta
bool process_chunk(ImageState *state, uint64_t offset);

// [确认] 0x3E0E340（374 B）—— 读内嵌流（≤0x10000 字节/块），内部走 0x419AB70/0x419ABE0/0x419AB80
bool read_embedded_stream(uint8_t *ctx, void *vec_out);

// [确认] 0x3E0ED70（129 B）—— 32 字节 → 64 字符小写 hex（String）
void to_hex(void *out_string, const uint8_t in[32]);

// [确认] 0x3E0D310 —— 把错误串写入 state；0x3E0E2E0 —— 基线缓存做零初始化
void set_error(ImageState *state, StringLike *msg);
void reset_baseline(void *dst);

// [确认] 0x3E10A00（10310 B）—— 脚本清单扫描（供 script_integrity 用，不属 ImageReader）
int  scan_script_manifest(int arg_bit);

}  // namespace impl

}  // namespace xiewa_guard2d

