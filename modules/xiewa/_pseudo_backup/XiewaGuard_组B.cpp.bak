// =============================================================================
//  XiewaCore.cpp
//  ——— 含 sign_blocked 的第二个原生类（"2"族）实现还原 ———
//
//  目标文件 : E:\gamezip\XiewaPai\XiewaPai.exe
//  SHA-256  : 9AF23B57A21ACDF30EBE09DEE97B7E03C2A759F3B1D5B318BFFCA4F8926B6081
//  RVA 基址 : 0x140000000 装载基址，文中地址 = RVA
//  IDA 基址 : 0x7FF7F46B0000（IDA 地址 = 0x7FF7F46B0000 + RVA）
//
//  【类名说明】
//  这个类在二进制里没有直接读到自己的名字。判定依据：
//    ① 它由独立注册流程 0x38F2A50 绑进 ClassDB（bind API 与第一族同为 0xCCE1A0）；
//    ② 名字串簇 0x51F6579~ 与第一族 0x50A2EC9~ 完全分离；
//    ③ .rdata 的类名区 0x4B9A12E 处 `Object / XiewaGuard / RefCounted /
//       register_abstract_class / XiewaCore / register_class` 里只有这两个候选类名。
//  故本文按 **XiewaCore** 命名（第一族 = XiewaGuard）。若与真实名不符，只影响命名。
//
//  【还原等级】
//    语义级伪代码。方法体逐条读过反汇编（见 _family2_bodies.asm 3248 行、
//    _family2_helpers.asm 777 行、_family2_helpers2.asm 1095 行）。
//    Win32 API / 常量 / 表字节 / 循环步进 = 实测；
//    局部变量名、参数次序、返回值语义 = [推定]；
//    内部例程 0x3900BB0 / 0x39011D0 / 0x3902250 等未定性处明确标注。
//
//  【全族共同结构】
//    12 个方法里 8 个以同一段"拦截门"开头（逐字节相同）：
//        若 (g_blockFlagsA | g_blockFlagsB) != 0 → 立刻返回空 String，什么都不做；
//        否则把 g_sigState 的位增量 lock-or 进 g_blockFlagsA，再返回空或继续。
//    这就是"被拦截后整套功能静默失效"的机制，sign_blocked 是它的查询端，
//    test_block 是它的置位端。
// =============================================================================

#include <cstdint>
#include <cstring>
#include <windows.h>

namespace xwc {

// =============================================================================
//  0. 全局状态（实测地址，均在 .data）
// =============================================================================
//
//  0x5484D98  g_blockFlagsA   uint32  被"拦截门"与 test_block 共写的标志字
//  0x5484D9C  g_blockFlagsB   uint32  只读（未发现写点）
//  0x560AAF4  g_sigState      uint32  运行时状态字（bit0~bit3 参与判定）
//  0x5485170  g_lastTs        uint64  上次时间戳（sign_blocked / sign2 的时间窗用）
//  0x562ACC0  g_os           Object* 单例，虚表 +0x228 取 ticks
//
extern uint32_t g_blockFlagsA;   // 0x5484D98
extern uint32_t g_blockFlagsB;   // 0x5484D9C
extern uint32_t g_sigState;      // 0x560AAF4
extern uint64_t g_lastTs;        // 0x5485170
extern Object  *g_os;            // 0x562ACC0

// =============================================================================
//  1. 拦截门（8 个方法的共同前导，逐字节相同）
//     以 device_wrap2 @0x38F1970 为准；各方法只是寄存器分配不同。
// =============================================================================
//
//  0x38F1983  mov  eax, [0x5484D98]
//  0x38F1989  mov  ecx, [0x5484D9C]
//  0x38F198F  or   ecx, eax
//  0x38F1991  jne  -> 返回空
//  0x38F1993  mov  ecx, [0x560AAF4]        ; g_sigState
//  0x38F1999  mov  edx, ecx
//  0x38F199B  and  edx, 1                  ; d = state & 1
//  0x38F199E  lea  eax, [rdx + 2]          ; 候选 = d + 2
//  0x38F19A1  test cl, 0xE                 ; state & 0xE
//  0x38F19A4  cmove eax, edx               ; 高三位为 0 → 退化为 d
//  0x38F19A7  test eax, eax
//  0x38F19A9  je   -> 放行（继续方法体）
//  0x38F19AB  lock or [0x5484D98], eax     ; 累积标志
//                                           → 返回空
//
//  注意：门"开"意味着 g_blockFlagsA/B 全 0 且 (state&1)+(state&2/4/8) 的增量为 0。
//  返回 true = 放行；返回 false = 被拦（调用方应直接交出空 String）。
bool gate()
{
    if ((g_blockFlagsA | g_blockFlagsB) != 0u)
        return false;                                  // 0x38F1991

    uint32_t st = g_sigState;                           // 0x38F1993
    uint32_t d  = st & 1u;                              // 0x38F199B
    uint32_t n  = (st & 0xE) ? (d + 2u) : d;            // 0x38F199E / 0x38F19A4
    if (n == 0u)
        return true;                                   // 0x38F19A9 → 放行
    InterlockedOr((volatile LONG *)&g_blockFlagsA, (LONG)n);   // 0x38F19AB
    return false;
}

// =============================================================================
//  2. 第二套熵生成器（"xw2"）—— 与第一族的固定常量完全不同
//     实测于 device_unwrap2 @0x38F1BC0..0x38F1C14（device_wrap2 内同样一段）
// =============================================================================
//
//  寄存器：rax=9(+0xB)  rcx=0xB(+7)  rdx=3(+5)  r8b=0x5A(+0x17)
//  循环 32 轮（cmp rax,0x169 结束；9 + 32*11 = 361 = 0x169）
//
//    v    = T10[rax & 0x1F]
//    v    = v * 9           (lea r15,[r15+r15*8])
//    v    = v * 5           (lea r15,[r15+r15*4])  => 45 * T10
//    v   += r8b
//    b    = TS [rcx & 0x1F]
//    b   ^= T11[rdx & 0x1F]
//    b   ^= T14[i]
//    b   ^= v
//    out[i] = b
//
//  四张表（全部实测字节）：
//    T10 @0x51F6500、T11 @0x51F6520、TS @0x51F6540（在 .rdata，紧贴方法名簇之前）
//    T14 @0x558A7D0（.data）
//
static const uint8_t kT10[32] = {
    0x94, 0x77, 0x50, 0x29, 0xae, 0xfb, 0xf8, 0x7d,
    0xa4, 0x63, 0x01, 0x59, 0x67, 0x23, 0xaa, 0xd1,
    0x30, 0x6c, 0xe5, 0x24, 0xea, 0xdd, 0x9c, 0xa3,
    0xbf, 0x4b, 0x8d, 0x34, 0x77, 0xd5, 0x5b, 0x7a
};
static const uint8_t kT11[32] = {
    0xa1, 0xf8, 0x72, 0x3e, 0xe3, 0x40, 0xc4, 0x47,
    0xd3, 0x59, 0xd2, 0xdc, 0xd2, 0x5c, 0xa2, 0x41,
    0x0f, 0x74, 0x59, 0xed, 0xe6, 0xf9, 0xea, 0xec,
    0xcb, 0x44, 0xbb, 0x76, 0xe5, 0xa8, 0xe7, 0x9e
};
static const uint8_t kTS[32] = {
    0x39, 0x16, 0x01, 0x07, 0x30, 0x9b, 0x49, 0x18,
    0x76, 0x47, 0xfe, 0x05, 0xac, 0x60, 0xc2, 0xd0,
    0x7b, 0xd5, 0xfa, 0xf8, 0x75, 0xc3, 0x09, 0xb3,
    0x6f, 0x8d, 0x10, 0x77, 0xe6, 0x5f, 0xf6, 0xd8
};
static const uint8_t kT14[32] = {
    0xf7, 0x3c, 0x5f, 0x78, 0x78, 0x3f, 0xff, 0xea,
    0x9e, 0x6b, 0xb9, 0x6e, 0xcb, 0x32, 0xfe, 0xe4,
    0x1b, 0x87, 0xf9, 0xdc, 0xd3, 0xc7, 0x11, 0x78,
    0x34, 0xda, 0x21, 0x46, 0x88, 0x24, 0x6a, 0x3a
};

void entropy2(uint8_t out[32])
{
    uint32_t rax = 9, rcx = 0xB, rdx = 3;
    uint8_t  seed = 0x5A;
    for (int i = 0; i < 32; ++i) {
        uint32_t v = (uint32_t)kT10[rax & 0x1F] * 45u;    // 9*5
        v = (v + seed) & 0xFF;
        uint8_t b = kTS[rcx & 0x1F];
        b ^= kT11[rdx & 0x1F];
        b ^= kT14[i];
        b ^= (uint8_t)v;
        out[i] = b;
        rax += 0xB; rcx += 7; rdx += 5; seed += 0x17;
    }
}
// ★ 按上式在真实表字节上实算，输出为固定常量：
//    DA 1B 03 0D 4B 57 8A E4 66 14 83 12 83 13 B0 E3
//    03 1C 32 70 C1 28 EF E4 70 94 77 0D 4E 87 E3 54
//    （与第一族的 14 AC F1 4B… 是两串互不相同的常量，同样每次调用恒定）

// =============================================================================
//  3. 三个辅助：派生 / DPAPI 分发 / 机器密钥
// =============================================================================

// -----------------------------------------------------------------------------
// 0x38F12E0  derive32 —— SHA-256 派生
//   实测调用：derive32(&out32 /*rcx*/, 0x20 /*edx 输出长度*/,
//                      "xiewa-dpapi2" /*r8*/, 0xC /*r9d = salt 长度*/)
//   体：0x2BFE6F0(SHA-256 update) + 0x2BFF3D0(finish) + cowdata 断言
//   ⇒ out = SHA256( salt || 输入 ) 取前 32 字节，salt 由调用点决定。
// -----------------------------------------------------------------------------
void derive32(uint8_t out[32], const void *in, size_t inLen,
              const char *salt, size_t saltLen)
{
    // [推定] 拼接后单次 SHA-256；用于把"熵 + 域标签"混成真正的密钥
    sha256_ctx ctx;
    sha256_init(&ctx);                       // IV 来自 0x50A2E60（= 标准 SHA-256 IV）
    sha256_update(&ctx, salt, saltLen);      // r8/r9 实参
    sha256_update(&ctx, in, inLen);
    uint8_t dig[32];
    sha256_finish(&ctx, dig);
    memcpy(out, dig, 32);
}

// -----------------------------------------------------------------------------
// 0x38F1730  dpapi_xfer —— DPAPI 分发器（r9d 选方向）
//   实测：唯一同时引用 CryptProtectData / CryptUnprotectData / LocalFree 的函数
//   调用形态（来自 device_unwrap2 @0x38F1C4D）：
//       dpapi_xfer(ret /*rcx*/, args /*rdx*/, entropy32 /*r8*/, 0 /*r9 = 方向*/)
//   ⇒ r9 = 0 走 Unprotect（取出）、= 1 走 Protect（封装）[推定，两者调用点各出现一次]
//   描述串统一为 **"xiewa-dpapi2"**（第一族是 "ombrel"，这是两族最直接的区分）。
// -----------------------------------------------------------------------------
String dpapi_xfer(const String &in, const uint8_t entropy[32], int dir)
{
    DATA_BLOB ent = { 32, (BYTE *)entropy };
    DATA_BLOB src = { (DWORD)in.length(), (BYTE *)in.ptr() };
    DATA_BLOB dst = { 0, nullptr };

    BOOL ok = dir
        ? CryptProtectData(&src, kDescXw2, &ent, nullptr, nullptr, 1, &dst)
        : CryptUnprotectData(&src, nullptr, &ent, nullptr, nullptr, 1, &dst);

    String ret;
    if (ok)
        ret = String::from_buffer(dst.pbData, dst.cbData);   // 0x2F37B0 assign(len)
    if (dst.pbData)
        LocalFree(dst.pbData);
    return ret;
}
//  kDescXw2 = L"xiewa-dpapi2"（UTF-16，12 字符 = 0xC，与 derive32 的 r9d 一致）

// -----------------------------------------------------------------------------
// 0x38F1D70  machine_key —— 机器/用户绑定密钥
//   与第一族 mutex_name 同源思路，但盐换成了 "xiewa-machine2"：
//     GetCurrentProcess → OpenProcessToken(TOKEN_QUERY) → GetTokenInformation(TokenUser)
//     → IsValidSid → GetLengthSid → (SID 字节) → derive32(…, "xiewa-machine2")
//     → dpapi_xfer 封装后返回
//   体内有一次自递归（0x38F1D70 → 0x38F1D70），疑为"取已缓存值 / 重试"分支。
// -----------------------------------------------------------------------------
String machine_key();

// =============================================================================
//  4. 四个 DPAPI 方法（"2"版）：全部先过 gate()
// =============================================================================

// -----------------------------------------------------------------------------
// device_wrap2 @0x38F1970 (285 insn)
//   门 → entropy2 → derive32("xw2-derive") → dpapi_xfer(dir=0) → 写回
// -----------------------------------------------------------------------------
String device_wrap2(const String &in)
{
    if (!gate()) return String();                    // 0x38F1991 / 0x38F19B2
    uint8_t ent[32]; entropy2(ent);                   // 0x38F19CE 之后
    uint8_t key[32];
    derive32(key, ent, 32, "xw2-derive", 10);         // "xw2-derive" 长度 0xA
    return dpapi_xfer(in, key, 0);                    // dir=0 → Unprotect
}

// -----------------------------------------------------------------------------
// device_unwrap2 @0x38F1B40 (267 insn) —— 体最完整的一个，可据此校正其余
//   0x38F1B94..: 生成 32 字节（第二套生成器）
//   0x38F1C16..: derive32(&buf, 0x20, "xiewa-dpapi2", 0xC)
//   0x38F1C4D..: dpapi_xfer(ret, args, buf, 0)
// -----------------------------------------------------------------------------
String device_unwrap2(const String &in)
{
    if (!gate()) return String();
    uint8_t ent[32]; entropy2(ent);
    uint8_t key[32];
    derive32(key, ent, 32, "xiewa-dpapi2", 12);
    return dpapi_xfer(in, key, 0);
}

// -----------------------------------------------------------------------------
// device_wrap_m2 @0x38F1C70 (284 insn)：门 → machine_key() → dpapi_xfer(dir=1)
//   （_m 后缀 = machine 绑定版，与第一族 device_wrap_m 的定位一致）
// -----------------------------------------------------------------------------
String device_wrap_m2(const String &in)
{
    if (!gate()) return String();                    // 0x38F1C87 / 0x38F1CAF
    String mk = machine_key();                       // 0x38F1CC1 之后
    if (mk.empty()) return String();
    return dpapi_xfer(in, (uint8_t *)mk.ptr(), 1);    // dir=1 → Protect
}

// -----------------------------------------------------------------------------
// device_unwrap_m2 @0x38F2000 (292 insn)
//   0x38F2011 call 0x38F1D70（machine_key）
//   0x38F2016 test al,al 失败 → 返回空
//   0x38F202D call 0x38F1730(dir=0)
// -----------------------------------------------------------------------------
String device_unwrap_m2(const String &in)
{
    String mk = machine_key();                       // 0x38F2011
    if (mk.empty()) return String();                 // 0x38F2018
    return dpapi_xfer(in, (uint8_t *)mk.ptr(), 0);    // 0x38F202D
}

// =============================================================================
//  5. 签名 / 派生 / 校验 三联
// =============================================================================

// -----------------------------------------------------------------------------
// sign2 @0x38F2050 (276 insn) —— 已逐条对齐，不再是推定
//   实际控制流（按址序）：
//     门 → 0x38F20C1 ticks → >>3 → /1000（幻数 0x20C49BA5E353F7CF + shr 4）
//     → 0x38F20DD last=[0x5485170]；last==0 直接跳到 0x38F2101
//     → 0x38F20F8 cmp (now-last),0x7D0；**jb 0x38F212C（窗口内 → 跳过写时+跳过扫描）**
//     → 0x38F2101 cmp rdx,1 / adc rdx,0 → [0x5485170]=now
//     → 0x38F2110 ecx=2 ; call 0x38F7B60（★自扫描，与 sign_blocked 同一调用）
//     → 0x38F2123 and eax,0x63 ; jne 0x38F209C（命中 → 提前走失败/空返回分支）
//     → 0x38F212C/0x38F2134：**参数标签判定**（UTF-32 字符串，长度字段 [rax-0x10]==6，
//       逐字符比 's'(0x73) 'a'(0x61) 'v'(0x76) 'e'(0x65) '5'(0x35)）
//       ⇒ 6 字符串 "save5…"，与 xiewa_list.txt 里 `s:"save"` 的同一类记录标签
//     → 命中标签：0x38F2165 call 0x39004A0（校验内核）；al==0 → 0x38F224F 返回失败
//     → 非该标签：0x38F2175 String::assign(0x20) 填 32 字节 →
//       0x38F2221 call 0x38F2780 → 0x38F2247 call 0x38F12E0(edx=0x20) → ret
// -----------------------------------------------------------------------------
String sign2(const String &payload, const String &key)
{
    if (!gate()) return String();                        // 0x38F2050 门

    uint64_t now = (uint64_t)g_os->call_virtual(0x228);   // 0x38F20C1
    now >>= 3;                                            // 0x38F20C8
    now /= 1000u;                                         // 0x38F20CC 幻数除 1000

    uint64_t last = g_lastTs;                             // 0x38F20DD
    if (last != 0u && (now - last) < 0x7D0u)               // 0x38F20F8 cmp r10,0x7d0
        return finish_tagged(payload, key);               // 0x38F212C：窗口内跳过扫描

    if (now == 0u) now = 1u;                              // 0x38F2101 cmp/adc
    g_lastTs = now;                                       // 0x38F2109
    int32_t scan = scan_copies(2);                        // 0x38F2115 call 0x38F7B60
    if ((scan & 0x63) != 0)                               // 0x38F2123 and eax,0x63
        return String();                                  // 0x38F2126 → 0x38F209C 失败分支

    // —— 标签判定（Godot String 是 UTF-32，故按 4 字节步进比较）——
    bool is_save5 = (payload.length() == 6) &&
                    (payload.char32(0) == 's') && (payload.char32(1) == 'a') &&
                    (payload.char32(2) == 'v') && (payload.char32(3) == 'e') &&
                    (payload.char32(4) == '5');
    if (is_save5) {
        if (!verify_core_39004A0(payload, key))            // 0x38F2165
            return String();                              // 0x38F216F → 0x38F224F
    }
    uint8_t buf[32];                                      // 0x38F2179 String::assign(0x20)
    String mid = derive_mid(buf);                         // 0x38F2221 call 0x38F2780
    uint8_t out[32];
    derive32(out, /*…*/nullptr, 0, "xw2-derive", 10);      // 0x38F2247 call 0x38F12E0
    return mid;
}

// -----------------------------------------------------------------------------
// derive2 @0x38F2510 (265 insn)：门 → entropy2 → 0x38F2780（盐 "xw2-derive"）→ 输出
// -----------------------------------------------------------------------------
String derive2(const String &seed)
{
    if (!gate()) return String();
    uint8_t ent[32]; entropy2(ent);
    uint8_t out[32];
    derive32(out, ent, 32, "xw2-derive", 10);       // 0x38F2780 内部同源调用
    return String::from_buffer(out, 32);
}

// -----------------------------------------------------------------------------
// verify2 @0x38F2300 (280 insn) + 0x39041F0
//   ★ 已排除上一版的"RSA 公钥验签"猜测。依据：把 0x39004A0 / 0x39041F0 及其 6 个
//     子例程全扫了一遍，**指令直方图里没有任何大数运算**——无 mul/adc/sbb 连锁、
//     无 0x10001、无 Montgomery 结构，全是 mov/lea/call/cmp/test/je 加极少量
//     movzx/movsx/shr/and（字符级）。子例程实际分工：
//        0x3900BB0  解析器        （0x12780B0 / 0x7D84A0 / 0x7C0680 / 0x7D4360）
//        0x39011D0  文本→状态     (★含 0x340ECE0 = 第一族 reg_read；0x6C23D0/0x6CDA20 = JSON)
//        0x3902250  base64 + 比对 (调 0x38F12E0 derive32 + 0x89FF00 String compare)
//        0x3902860  拼 XWL 文本    (0x8A65A0 String→utf16、0x89C6A0/0x89BF50)
//        0x3903A00  纯缓冲区操作   (只有 new/delete)
//        0x3902460  错误/清理      (0x14EDDD0 / 0x8A91F0)
//     ⇒ 真实性质 = "解析 license 文本 + base64 解码 + SHA-256 派生 + 字符串比对"；
//       `-----BEGIN PUBLIC KEY-----` 只是 license 文本里的**格式标记**，不参与非对称运算。
//     串里的 "K1K2lv-namelv-mlv-ulv-mac" = 被解析的字段名（K1/K2 更像两段摘要而非公钥）。
// -----------------------------------------------------------------------------
bool verify2(const String &lic, const String &sig)
{
    if (!gate()) return false;                      // 门不过 → 视为校验失败
    return license_verify_text(lic, sig);           // 0x39041F0
}

// =============================================================================
//  6. sign_blocked @0x38F2460（270 insn，真正的方法体只有前 70 字节 + 时间窗尾）
//     这是"拦截状态查询端"，与 gate() 共享同一组全局。
// =============================================================================
//  ★ 全文（0x38F2460..0x38F250A，共 34 条指令，三个块）已完整读完，无遗留。
//  重要：它不是纯查询——第三块**自己会跑一次副本扫描**，命中就把结果位 or 进标志，
//  所以 sign_blocked 同时也是"探测器"。
int32_t sign_blocked()
{
    // ---- 块 1（0x38F2464..0x38F247D）----
    //   ecx=[A] edx=[B] eax=1 or edx,ecx je 块2 ; 否则 add rsp,0x28;ret → 返回 1
    if ((g_blockFlagsA | g_blockFlagsB) != 0u)
        return 1;

    // ---- 块 2（0x38F247E..0x38F24A5）----
    //   eax=[state] edx=eax&1 ecx=edx+2 test al,0xE cmove ecx,edx
    //   test ecx,ecx je 块3 ; 否则 lock or [A],ecx ; eax=1 ; ret
    uint32_t st = g_sigState;                          // [0x560AAF4]
    uint32_t d  = st & 1u;
    uint32_t n  = (st & 0xE) ? (d + 2u) : d;
    if (n != 0u) {
        InterlockedOr((volatile LONG *)&g_blockFlagsA, (LONG)n);   // 0x38F2495
        return 1;
    }

    // ---- 块 3（0x38F24A6..0x38F250A）：时间窗 + 自扫描 ----
    Object  *os  = *(Object **)0x562ACC0;               // 0x38F24A6
    uint64_t now = (uint64_t)os->call_virtual(0x228);   // 0x38F24B0
    now >>= 3;                                          // 0x38F24B6
    now /= 1000u;                                       // 0x38F24BA mul 0x20C49BA5E353F7CF, shr 4
    uint64_t last = g_lastTs;                           // 0x38F24CB  [0x5485170]
    if (last != 0u) {                                   // 0x38F24D4 test rcx,rcx; je 0x38F24E8
        uint64_t dt = now - last;                       // 0x38F24DC
        if (dt < 0x7D0u)                                // 0x38F24DF cmp r8,0x7D0; jb 0x38F2479
            return 0;                                   //   → 2000 单位内直接放行，不做扫描
    }
    // 0x38F24E8：cmp rdx,1 ; adc rdx,0  → 保证写入值 >= 1（0 会被当作"未初始化"）
    if (now == 0u) now = 1u;
    g_lastTs = now;                                     // 0x38F24F0
    int32_t r = scan_copies(2);                         // 0x38F24FC call 0x38F7B60, ecx=2
    if ((r & 0x63) != 0) {                              // 0x38F2505 and ecx,0x63
        InterlockedOr((volatile LONG *)&g_blockFlagsA, (LONG)(r & 0x63));  // 0x38F2508 → 0x38F2495
        return 1;
    }
    return 0;                                           // 0x38F250A jmp 0x38F2479
}

// =============================================================================
//  7. 环境 / 副本检测：test_block @0x38F8790（238 insn）
//     0x38F87A1 串簇： "release|Ombrel|Cache|LOCALAPPDATA|PROGRAMDATA|evatfpallcopiesherefirstn…"
//     并 call 0x340ECE0 = **第一族的 reg_read**（读 HKLM\Software\...\ 的值）
//     扫描逻辑在 0x38F7B60（310+ insn，另有 "LOCALAPPDATAPROGRAMDATAevatfpall…" 串）
//     ⇒ 它把"注册表里第一族写下的记录"和"磁盘上的副本"两路结果汇总，命中即置位。
// =============================================================================
bool test_block()
{
    // 0x38F87A1 起
    String s_rel  = kIsReleaseTemplate;   // "release"（第一族常量，跨族复用）
    String s_vend = kVendor;              // "Cache"
    String s_dir1 = "LOCALAPPDATA";
    String s_dir2 = "PROGRAMDATA";
    String s_mark = "evatfpall";          // 副本指纹串 [推定]

    String reg = xwg::reg_read(reg_a(), reg_b(), "cache");   // 0x340ECE0 跨族调用
    bool   dup = scan_copies(s_dir1, s_dir2, s_mark);          // 0x38F7B60
    bool   hit = (!reg.empty()) || dup;

    if (hit) {
        InterlockedOr((volatile LONG *)&g_blockFlagsA, 1);    // 0x38F7B10 / 0x38F8710
        return true;
    }
    return false;
}

// =============================================================================
//  8. 编辑器 / 无头环境两联
// =============================================================================

// -----------------------------------------------------------------------------
// editor_check @0x38F2DB0 (236 insn)
//   串 "name|xw-bind|xw-chk--headless"（与 name2 共用同一串簇）
//   唯一带 EnterCriticalSection / LeaveCriticalSection 的方法之一
//   ⇒ 判定"是否在编辑器 / headless 环境"，结果影响 editor_cleanup 的清理范围
// -----------------------------------------------------------------------------
bool editor_check()
{
    EnterCriticalSection(&g_csLock);                 // 实测
    bool headless = detect_headless("--headless");   // 依据串簇 [推定]
    bool in_editor = detect_editor();                // [推定]
    LeaveCriticalSection(&g_csLock);
    return headless || in_editor;
}

// -----------------------------------------------------------------------------
// editor_cleanup @0x38F3250 (249 insn)
//   同串簇 + 临界区；调 0x38F3960（文件枚举族）与 0x39054B0
//   ⇒ 清理编辑器/无头环境下产生的痕迹文件
// -----------------------------------------------------------------------------
int32_t editor_cleanup()
{
    EnterCriticalSection(&g_csLock);
    int removed = purge_editor_traces();             // 0x38F3960
    LeaveCriticalSection(&g_csLock);
    return removed;
}

// =============================================================================
//  9. name2 @0x38F36F0（270 insn）
//     "name|xw-bind|xw-chk--headless" + "0123456789abcdef" + hex_decode + cowdata 断言
//     ⇒ 把通道名（xw-bind / xw-chk）按 hex 解码后返回
// =============================================================================
String name2(const String &channel)
{
    // 0x38F381D 的 "0123456789abcdef" 是 Godot 的 hex 表，配合 hex_decode
    return hex_decode(channel);                      // 0x8B27C0 侧实现 [推定]
}

} // namespace xwc

// =============================================================================
//  附录 A —— 12 个方法 / 地址 / 关键调用一览
// -----------------------------------------------------------------------------
//  方法              RVA        指令数   关键调用与字符串
//  device_wrap2      0x38F1970  285     gate, entropy2, derive32("xw2-derive"), dpapi(0)
//  device_unwrap2    0x38F1B40  267     gate, entropy2, derive32("xiewa-dpapi2",12), dpapi(0)
//  device_wrap_m2    0x38F1C70  284     gate, machine_key, dpapi(1)
//  device_unwrap_m2  0x38F2000  292     machine_key, dpapi(0)
//  sign2             0x38F2050  276     gate, ticks+窗(0x7D0), scan_copies(2), 标签"save5…",
//                                       0x39004A0, 0x38F2780, 0x38F12E0
//  derive2           0x38F2510  265     gate, entropy2, 0x38F2780("xw2-derive"), 0x89FF00
//  verify2           0x38F2300  280     gate, 0x38F2780, 0x39041F0（*非* RSA，见 §5 注释）
//  sign_blocked      0x38F2460  270     ①标志→1 ②状态位→置位→1 ③窗(0x7D0)+自扫描→置位
//  test_block        0x38F8790  238     reg_read(0x340ECE0) + 0x38F7B60 目录扫描
//  editor_check      0x38F2DB0  236     临界区 + "--headless" 判定
//  editor_cleanup    0x38F3250  249     临界区 + 0x38F3960 清理
//  name2             0x38F36F0  270     "0123456789abcdef" hex_decode
//
//  辅助：
//  0x38F12E0  derive32    SHA-256( salt || in ) → 32B
//  0x38F1730  dpapi_xfer  CryptProtect/UnprotectData，desc = "xiewa-dpapi2"
//  0x38F1D70  machine_key SID → derive32("xiewa-machine2") → DPAPI
//  0x38F2780  派生封装     entropy2 + derive32 + 0x89FF00(String 比较)
//  0x38F7B60  副本扫描     LOCALAPPDATA / PROGRAMDATA / evatfpall…（被 sign2 与 sign_blocked 共用）
//  0x39004A0  校验内核     解析 → base64 → derive32 → String 比对（无大数运算）
//  0x39041F0  许可校验     同上 + PEM 格式标记 + K1/K2/lv-name/lv-ml/lv-ul/lv-mac 字段
//  0x1FAB20   Variant/Callable 辅助（只调 0x28040/0x28070/0x280B0/0x280D0）
// =============================================================================

