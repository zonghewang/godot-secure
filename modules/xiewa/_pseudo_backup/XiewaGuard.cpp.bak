//  pepper                      0x340CBE1 0x340E890  熵生成器（同一函数体）
//  reg_write                   0x340CD01 0x340EA70  HKLM + RegCreateKeyExW/RegSetValueExW(REG_BINARY)
//  reg_read                    0x340CE21 0x340ECE0  RegOpenKeyExW/RegQueryValueExW ×2
//  reg_erase                   0x340CF41 0x340EF00  仅 RegQueryValueExW 探测（无删除 API）
//  flush_file                  0x340D061 0x340F320  CreateFileW(0x40000000,7,3,0x80)+FlushFileBuffers
//  move_file_durable           0x340D0A8 0x340F400  MoveFileExW(flags=8 WRITE_THROUGH)
//  single_instance_acquire     0x340D0EF 0x340F520  CreateMutexW(bInitialOwner=TRUE)+GetLastError(0xB7)
//  is_release_template         0x340D211 0x340F5A0  "release"
//  flavor                      0x340D258 0x340F5E0  "Ombrel"
//  vendor                      0x340D29F 0x340F620  "Cache"
//  reg_subkey                  0x340D2E6 0x340F660  "cache"
//  cache_dir                   0x340D32D 0x340F6A0  "Local\Ombrel.{18657BB7-...}"
//  mutex_name                  0x340D374 0x340F6E0  TokenUser SID + SHA-256
//
//  统一的"无状态"证据：类无成员变量；所有方法只做 取参→调 Win32→写回；
//  数据全部落在 HKLM 注册表、DPAPI 加密串、文件名/缓冲里，不在对象内。
