//        该处尚未逐字节核到，见附录 B）。
// -----------------------------------------------------------------------------
Variant scan_runtime_detection()
{
    Variant ret;
    ret = Variant();              // 0x8A06F0 构造，前置 qword[rsi]=0
    return ret;
}

