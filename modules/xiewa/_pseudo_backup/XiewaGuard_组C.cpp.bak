// =============================================================================
//  附录 D —— 后续实测补正：组C 用到的真实字段名（0x52A23EA–0x52A2476 串块）
// =============================================================================
#if 0
上一节 script_integrity / engine_flags 里的 "bits"/"high"/"bad"/"none" 是按早期骨架读到的；
本轮把 0x52A1E00–0x52A2600 整块串读出后，发现同一区域还有一整组**与清单/引擎标记直接对应**的字段名，
二者应为同一函数的不同分支标签（谁在前谁在后需按 0x3E13260 逐条对齐）：

manifest                              0x52A23EA   ← 清单（对应 XiewaPai.pck.rules）
manifest_files                        0x52A23F3
registered                            0x52A2402   ← 已登记脚本数
builtin_skipped                       0x52A240D   ← 内置脚本跳过数
core_loaded                           0x52A241D   ← 核心脚本已加载数
core_total                            0x52A2429
checked                               0x52A2434
mismatch                              0x52A243C
unknown                               0x52A2445
last_us                               0x52A244D   ← 耗时（微秒）
engine_flags                          0x52A2455   ← 与 engine_flags 方法同名
res://                                0x52A2462
runtime                               0x52A246E   ┐ 合起来即 res://runtime.scripts
.scripts                              0x52A2476   ┘ （.pck.scripts 的引擎侧路径）

⇒ engine_flags 返回的就是这组统计：{manifest, manifest_files, registered, builtin_skipped,
   core_loaded, core_total, checked, mismatch, unknown, last_us}；
   script_integrity 负责产出 checked/mismatch/unknown 三个计数。
#endif
