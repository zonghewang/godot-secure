// =============================================================================
//  XiewaGuard_组C.cpp  —— 组C（桥接/授权/清单）21 个方法的实现级还原
//
//  类归属   : XiewaGuard（ClassDB 具体类）
//  绑定批次 : 第三批，由 0x38F2A50? 否 → 由 0x3910350 完成；绑定点 0x3910471 … 0x39111B8
//             绑定函数起点 0x3910350：push r14/rsi/rdi/rbx; sub rsp,0x48; mov ecx,0x58
//  来源     : E:\gamezip\XiewaPai\XiewaPai.exe（SHA256 9AF23B57…B6081）
//  方式     : capstone 反汇编（_bridge_bodies.asm 16 个唯一实现体 / _skel2.txt 严格骨架）
//  标注     : [确认] = 反汇编直接可见；[推定] = 由调用约定与上下文推断；[未知] = 未闭环
//
//  21 个绑定点只对应 16 个唯一实现体，5 组共用同一实现指针（见文末附录 A）。
//  本文件按"每个唯一实现体一段代码"组织，共用体在注释中说明别名。
// =============================================================================

#include "XiewaGuard.h"
#include "core/variant/dictionary.h"
#include "core/string/ustring.h"

// -----------------------------------------------------------------------------
//  组C 共享件（非本类成员，均在本模块内）
// -----------------------------------------------------------------------------
namespace xc {

// 全局状态（RVA 均为 .data 段）
extern uint8_t  g_listReady;      // 0x558A6C1 —— 清单是否已加载（由 0x390C810 / 0x390C886 计算得）
extern uint8_t  g_deferInit;      // 0x548B148 —— defer 子系统是否已初始化（由 0x38FF4E6 / 0x38FF4FE 计算得）
extern uint8_t  g_sigState;       // 0x560AAF4
extern uint8_t  g_blockFlagsA;    // 0x5484D98
extern uint8_t  g_blockFlagsB;    // 0x5484D9C
extern uint8_t  g_lastTs;         // 0x5485170
extern CRITICAL_SECTION g_cs;     // 0x5484CE8 一带（校验用全局临界区）

// 共享例程（签名按调用点形态反推）
Variant  state_obj();                 // 0x39054B0  取全局状态对象（CS 保护）
Variant  state_get(int slot);         // 0x38FD050 取状态对象（[+0x34] 初始化标志、[+0x1F8]/[+0x208] 虚调）
Variant  record_container();          // 0x38FB140 取记录容器
int      scan_copies(int mode);       // 0x38F7B60 副本扫描器（LOCALAPPDATA/PROGRAMDATA/evatfpall…）
String   digest_core(const String&);  // 0x390C520 摘要内核
bool     list_verify(const String&);  // 0x390B240 清单校验
Variant  unseal_parse(const String&); // 0x390EA40 unseal 通道解析
Vector<String> receipt_split(const String&); // 0x390F8A0 receipt 字段拆分
String   sha256_hex(const String&);   // 0x39194E0 → 32B，再按 "0123456789abcdef" 转 hex

String   take_arg(const Variant** args);     // 0x898ED0 取实参（1/2 参）
Variant  dict_get(const Dictionary&, const String&); // 0x7BAAB0
String   json_read(const String&);    // 0x6C23D0
Variant  json_parse(const String&);   // 0x6CDA20
String   path_join(const String&, const String&);   // 0x7D4360
String   str_add(const String&, const String&);     // 0x896E90 / 0x8942A0? [推定]

}  // namespace xc

using namespace xc;

// =============================================================================
//  1) bridge_check(flags)                    绑定点 0x3910471  实现 0x38F7AD0（26 指令）
//     与 sign_blocked 共用副本扫描器；结果是"错误掩码"而非布尔。
// =============================================================================
int XiewaGuard::bridge_check(int flags) {
    Variant st;
    EnterCriticalSection(&g_cs);
    st = state_obj();                              // 0x38F7AD0: call 0x39054B0
    LeaveCriticalSection(&g_cs);

    int r = scan_copies(2);                        // 0x38F7B60(2)：只扫第 2 类位置

    // 0x38F2AC? 段：test sil,2 —— sil 即 flags 低 8 位
    if (flags & 2) {
        // 按位收敛到 0x63（0b0110_0011）—— 与组B sign_blocked 的掩码完全一致
        r = (r & 0x63);
        if (r) {
            lock_or(g_blockFlagsA, r);             // lock or [0x5484D98], r  [推定]
        }
    }
    return r;                                      // [推定] 0 = 干净；非 0 为命中位掩码
}

// =============================================================================
//  2) script_integrity(opts)                绑定点 0x3910591  实现 0x3E13260（312 指令）
//     可执行文件完整性自校验；与 xiewa_guard2d::ImageReader 的错误串同一模块。
// =============================================================================
String XiewaGuard::script_integrity(const Variant &opts) {
    // [确认] 调用 0x24A80（取当前模块路径/文件句柄）、0x3E10A00（PE 头/节表读取）
    //        判失败分支时逐级映射错误串：
    //          header_read_failed / invalid_dos_signature / text_read_failed /
    //          relocation_chunk_range_error
    PackedByteArray img = read_module_image();      // 0x24A80
    int err = pe_read_text(img);                    // 0x3E10A00

    // [确认] 结果标签常量：bits / high / bad / none
    if (err != 0) {
        // test bl,0x7f —— 低位 7 bit 视为"位图"
        return (err & 0x7f) ? String("bad") : String("none");
    }
    // [推定] 正常路径把 text 段摘要写进 "bits"/"high" 两份结果，返回状态串
    return String("high");                          // 命中阈值时
}

// =============================================================================
//  3) engine_flags()                        绑定点 0x39105D8  实现 0x38F8820（339 指令）
//     ⚠ 内部直接复用 XiewaGuard::reg_read(0x340ECE0) —— 类内方法互调的确证。
// =============================================================================
Variant XiewaGuard::engine_flags() {
    // [确认] 先取两个常量构件：flavor()="Ombrel"、vendor()="Cache"
    String subkey = String("Ombrel") + "\\" + String("Cache");

    // [确认] 0x38F8820 内 call 0x340ECE0 —— 即本类 reg_read，读 HKLM\Software\...\cache
    String stored = this->reg_read(subkey);         // 0x340ECE0

    Variant flags = state_flags_from(subkey);        // 0x38FA070

    // [确认] 环境变量分支：LOCALAPPDATA / PROGRAMDATA
    String local  = OS::get_singleton()->get_environment("LOCALAPPDATA");
    String common = OS::get_singleton()->get_environment("PROGRAMDATA");

    // [确认] 两个 JSON 读入口：0x6C23D0（读文件）、0x6CDA20（解析）
    String raw = json_read(path_join(local, "Ombrel/cache.json"));
    Variant j   = json_parse(raw);

    Dictionary d;                                    // [推定] 返回 "container" 形式的结果字典
    d["raw"]    = raw;
    d["parsed"] = j;
    d["reg"]    = stored;
    d["flags"]  = flags;
    return d;
}

// =============================================================================
//  4) machine_fp()                          绑定点 0x391061F  实现 0x38F7230（327 指令）
//     与 devlimit_state 同体（同一实现指针）。
//     四个系统 API 串起来：注册表 + SMBIOS 固件表 + Windows 目录 + 卷信息。
// =============================================================================
String XiewaGuard::machine_fp() {
    String fp;

    // --- (a) 注册表机器标识 ---------------------------------------------------
    // [确认] RegGetValueW(hKey = 0xFFFFFFFF80000002 = HKEY_LOCAL_MACHINE,
    //                     pszSubKey/pszValue 见 0x38F72xx 的 lea,
    //                     dwFlags = 0x10002 = RRF_RT_REG_SZ|RRF_RT_REG_EXPAND_SZ，
    //                     先传 NULL 取长度，再取内容)
    String regval = reg_get_value_machine();

    // --- (b) SMBIOS 固件表 ----------------------------------------------------
    // [确认] GetSystemFirmwareTable('RSMB' = 0x52534D42, 0, NULL, 0) 取长度 →
    //        再取表 → 逐字节走 SMBIOS 结构（type 1 System Information）：
    //        校验 cmp cl,0x7f（字符串索引上限）、cmp r8b,0x18（结构长度）、cmp cl,1（type==1）
    //        → 取 UUID/序列号字段
    String smbios = read_smbios_type1();             // 两段探测：cmp eax,7 → 长度 → 内容

    // --- (c) Windows 目录 -----------------------------------------------------
    // [确认] GetWindowsDirectoryW(buf, 0x104)
    String windir = get_windows_directory();         // 缓冲 0x104

    // --- (d) 卷信息 -----------------------------------------------------------
    // [确认] GetVolumeInformationW(root, volname, 0x104, &serial, &maxlen, &flags, &fsname, 0x104)
    String vol = get_volume_information(windir.left(1) + ":\\");

    fp = regval + "|" + smbios + "|" + windir + "|" + vol;   // [推定] 拼接方式（具体分隔符未定）
    return fp;
}

// 绑定点 0x3910655，实现指针与 machine_fp 完全相同
String XiewaGuard::devlimit_state() {
    return machine_fp();          // [确认] 同一实现体，参数槽未使用
}

// =============================================================================
//  5) devlimit_mark(v)                      绑定点 0x391069C  实现 0x38FBE00（305 指令）
//     写一条"设备限额/到期"记录：ev + at + fp（= 事件 / 时间 / 指纹）。
// =============================================================================
Variant XiewaGuard::devlimit_mark(const Variant &v) {
    Dictionary rec;

    // [确认] 字段名常量："ev"、"at"、"fp"
    rec["ev"] = dict_get(v, "ev");

    // [确认] 时间格式化："%04d-%02d-%02dT%02d:%02d:%02d"
    //        时间源 = 时间单例虚调用 [rax+0x1F8]（OS::get_datetime_dict_from_system 一类）
    String when = str_format_time("%04d-%02d-%02dT%02d:%02d:%02d", os_time()); // 0x69D440
    rec["at"] = when;

    // [确认] 指纹取 0x38FB140（记录容器内已有 fp），缺省时回落到 machine_fp
    rec["fp"] = record_container();

    // [确认] 写入（0x38FB140 的写侧）
    return records_update(rec);
}

// =============================================================================
//  6) devlimit_clear(v)                     绑定点 0x39107C1  实现 0x390E670（221 指令）
//     与 unseal_receipt 同构的通道串，语义是"解除限额记录"。
// =============================================================================
Variant XiewaGuard::devlimit_clear(const Variant &v) {
    // [确认] 串构造："XIEWA-UNSEAL|" + <实参> + "|M"
    String ch = String("XIEWA-UNSEAL|") + take_arg(v) + "|M";

    // [确认] 0x890EA40 —— unseal 通道解析（与 unseal_receipt 共用）
    Variant parsed = unseal_parse(ch);

    // [确认] test bl,bl 分支；两条路径分别清理 "Ombrel" / "Cache" 下的记录
    if (!parsed_is_ok(parsed)) {
        clear_records(path_join(flavor(), vendor()));   // "Ombrel"/"Cache"
        return false;
    }
    clear_records(path_join(flavor(), vendor()));
    return true;
}

// =============================================================================
//  7) defer_note(v)                         绑定点 0x3910808  实现 0x38FC640（316 指令）
//     "延迟/待办"记录：键集合 all / ev / first / need_d / need_n。
// =============================================================================
Variant XiewaGuard::defer_note(const Variant &v) {
    Dictionary d;
    // [确认] 五个键常量
    d["all"]    = dict_get(v, "ev");      // "all" 与 "ev" 两个键在骨架里相邻出现
    d["ev"]     = dict_get(v, "ev");
    d["first"]  = dict_get(v, "first");
    d["need_d"] = dict_get(v, "need_d");
    d["need_n"] = dict_get(v, "need_n");

    // [确认] 落到 0x38FB140 容器（与 devlimit_mark 同一记录层）
    return records_update(d);
}

// =============================================================================
//  8) defer_boot(v)                         绑定点 0x3910921  实现 0x38FF4C0（346 指令）
//     与 defer_state 同体。首次启动判定 + 按 Variant 类型分派。
// =============================================================================
Variant XiewaGuard::defer_boot(const Variant &v) {
    // [确认] 一次性初始化：cmp byte[0x548B148],1 → jne 初始化 → mov byte[0x548B148],1
    if (!g_deferInit) {
        init_defer();
        g_deferInit = 1;
    }

    // [确认] 0x38FD050 取状态对象；[rax+0x34] 为"已存在"标志，[rax+0x208] 虚调取当前时间
    Variant st = state_get(0);
    if (!state_ready(st)) return Variant();       // [rax+0x34] 判空

    Variant now = virtual_call_time(st);          // [rax+0x208]

    // [确认] 三键 first / need_n / need_d
    Dictionary d;
    d["first"]  = is_first_run();
    d["need_n"] = need_n(now);
    d["need_d"] = need_d(now);

    // [确认] 类型跳表：cmp ecx,3; ja default; jmp [table+rcx*8]（Variant 类型 0..3 取值）
    return dispatch_by_variant_type(d, v);
}

// 绑定点 0x3910957，实现指针与 defer_boot 完全相同
Variant XiewaGuard::defer_state() {
    return defer_boot(Variant());
}

// =============================================================================
//  9) list_apply(v)                         绑定点 0x3910A71  实现 0x3906250（308 指令）
//     与 list_state 同体。清单应用：字段 container/ok/changed/err/ver/sig/old/format。
// =============================================================================
Variant XiewaGuard::list_apply(const Variant &v) {
    // [确认] Dictionary 分配：mov ecx,0x80（分配尺寸）、mov [rax+0x30],2（容器类型=Dictionary）
    Dictionary out;
    out["container"] = dict_get(v, "container");
    out["ok"]        = dict_get(v, "ok");
    out["changed"]   = dict_get(v, "changed");
    out["err"]       = dict_get(v, "err");
    out["ver"]       = dict_get(v, "ver");       // 版本（对应 xiewa_list.txt 的 ver）
    out["sig"]       = dict_get(v, "sig");       // 签名
    out["old"]       = dict_get(v, "old");       // 旧条目
    out["format"]    = dict_get(v, "format");

    // [确认] 键查走 0x7BAAB0；其后做 byte 类型判定
    EnterCriticalSection(&g_cs);
    Variant r = out;                             // [推定] 未在骨架中看到写回全局，返回组装结果
    LeaveCriticalSection(&g_cs);
    return r;
}

// 绑定点 0x3910AA7，实现指针与 list_apply 完全相同
Variant XiewaGuard::list_state() {
    return list_apply(Variant());
}

// =============================================================================
//  10) list_raw()                           绑定点 0x3910BC1  实现 0x390C7E0（135 指令）
//      返回清单原始文本（不做校验），拿 XiewaPai.pck.rules / xiewa_list.txt 的原文。
// =============================================================================
String XiewaGuard::list_raw() {
    EnterCriticalSection(&g_cs);
    Variant st = state_obj();                    // 0x39054B0

    // [确认] cmp byte[0x558A6C1],1 —— 已加载才返回内容（0x390C810 处取该全局）
    if (!g_listReady) {
        LeaveCriticalSection(&g_cs);
        return String();
    }

    // [确认] 拼串（"XWL1" 头 + base64 + 签名），返回 String
    String raw = list_join_raw();                 // 0x390B? / String += 链
    LeaveCriticalSection(&g_cs);
    return raw;
}

// =============================================================================
//  11) list_check_profile(profile)          绑定点 0x3910CE1  实现 0x390C860（101 指令）
// =============================================================================
Variant XiewaGuard::list_check_profile(const String &profile) {
    EnterCriticalSection(&g_cs);

    // [确认] cmp byte[0x558A6C1],1 —— 未加载直接返回空
    if (!g_listReady) {
        LeaveCriticalSection(&g_cs);
        return Variant();
    }

    String arg = take_arg_1(profile);             // 0x898ED0（1 参 / 2 参共用）
    // [确认] cmp ebx,1 —— 参数个数判定
    if (arg_count != 1) { LeaveCriticalSection(&g_cs); return Variant(); }

    String p1 = normalize(arg);                   // 0x8906840（两次调用：规范化 + 比较用）
    String p2 = normalize(arg);

    String dig = digest_core(p1);                 // 0x390C520
    bool   ok  = list_verify(p2);                 // 0x390B240

    LeaveCriticalSection(&g_cs);
    Dictionary d;
    d["ok"]  = ok;
    d["dig"] = dig;
    return d;
}

// =============================================================================
//  12) id_hash(id)                          绑定点 0x3910D28  实现 0x390CB50（49 指令）
// =============================================================================
String XiewaGuard::id_hash(const String &id) {
    // [确认] String 有效性判定：取 [rax-0x10]（Godot String 前缀头），
    //        cmp eax,0x70（堆存储）/ 0x6d（内联小串）两种类型码
    if (!string_is_valid(id)) return String();

    // [确认] 走摘要内核
    return digest_core(id);                       // 0x390C520
}

// =============================================================================
//  13) list_check_hash(hash)                绑定点 0x3910E41  实现 0x390CA20（79 指令）
//      与 svc_verify / ck_state 同体。要求 17 字符定长哈希。
// =============================================================================
Variant XiewaGuard::list_check_hash(const String &hash) {
    // [确认] test r9,r9 → 空判；类型 0x70/0x6d 判定；cmp dword[r9-0x10],0x11（**17 字符**）
    if (!string_is_valid(hash)) return false;
    if (hash.length() != 17)    return false;

    EnterCriticalSection(&g_cs);
    Variant st = state_obj();                     // 0x39054B0
    bool ok = list_verify(hash);                  // [推定] 进入校验内核
    LeaveCriticalSection(&g_cs);
    return ok;
}

// 绑定点 0x3910E77 / 0x3910F25，实现指针与 list_check_hash 完全相同
Variant XiewaGuard::svc_verify(const String &sig) { return list_check_hash(sig); }
Variant XiewaGuard::ck_state()                    { return list_check_hash(String()); }

// =============================================================================
//  14) unseal_receipt(key)                  绑定点 0x3911051  实现 0x390F1A0（331 指令）
// =============================================================================
String XiewaGuard::unseal_receipt(const String &key) {
    // [确认] 首段拼串："XIEWA-UNSEAL|" + key + "|M"
    String ch = String("XIEWA-UNSEAL|") + key + "|M";

    // [确认] 0x390EA40 —— 通道解析/校验
    Variant r1 = unseal_parse(ch);

    // [确认] test bpl,bpl 分支：成功路径再拼一段（追加 machine/fp 与 "|" 分隔）并二次解析
    if (unseal_ok(r1)) {
        String ch2 = ch + "|" + machine_or_fp();
        Variant r2 = unseal_parse(ch2);           // 二次 0x390EA40
        return receipt_from(r2);
    }
    return receipt_from(r1);
}

// =============================================================================
//  15) receipt_ok(receipt, expect)          绑定点 0x3911171  实现 0x390FFA0（68 指令）
// =============================================================================
bool XiewaGuard::receipt_ok(const String &receipt, const String &expect) {
    // [确认] 长度 + 0x890F8A0 拆分（两段），cmp r8d,eax 比长度，
    //        shl r8,2（长度 ×4，指向 UTF-32 载荷）后逐段比
    Vector<String> parts = receipt_split(receipt);        // 0x890F8A0
    if (parts.size() < 2) return false;

    unsigned r8 = parts[0].length();
    unsigned eax = parts[1].length();
    if (r8 != eax) return false;

    return parts[0] == parts[1] || parts[0] == expect;     // [推定] 最终比较形式
}

// =============================================================================
//  16) unseal_legacy_ok(receipt)            绑定点 0x39111B8  实现 0x3910070（184 指令）
//      兼容旧版 receipt（旧版 66MB 无组C，此方法处理"legacy"格式）。
// =============================================================================
bool XiewaGuard::unseal_legacy_ok(const String &receipt) {
    // [确认] 拼串(0x896E90 +=) → 0x8A2660（取模块/机器信息）→ r9d=0x10（**16 字符**子串）
    String base = String("XIEWA-UNSEAL|") + receipt;
    base += module_or_machine();                  // 0x8A2660

    // [确认] 0x895ED0 取 16 字符切片
    String cut = substr_16(base);                 // r9d = 0x10

    // [确认] 与既有记录比较（未展开最后的 memcmp 目标，属 [未知]）
    return compare_with_stored(cut);
}

