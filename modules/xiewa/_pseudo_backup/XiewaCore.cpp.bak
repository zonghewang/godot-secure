// 外部辅助（同模块内）
String sha256_hex_of(const void *data, size_t len);   // 0x39194E0 哈希 + "0123456789abcdef" hex
String hmac_sha256_hex(const void *key, size_t klen,
                       const void *msg, size_t mlen); // 0x391BD00

